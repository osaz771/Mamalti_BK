@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var sessionName = ViewBag.UserName as string;  
    var cookieName = ViewBag.LastUser as string;    
}

<div id="welcome-container" style="text-align:center; margin-top:20px;">
    <h2 id="welcome-text"></h2>
</div>

<script>
    window.onload = function () {

        var sessionName = "@sessionName";
        var cookieName = "@cookieName";

        var finalName = "";

        if (sessionName && sessionName.trim() !== "") {
            finalName = sessionName;
        }
        else if (cookieName && cookieName.trim() !== "") {
            finalName = cookieName;
        }
        else {
            finalName = "User";
        }

        document.getElementById("welcome-text").textContent =
            "Welcome " + finalName;
    };
</script>


<section class="body-div">
    <h1 class="main-title">
        Muamalati Platform <br />
        All Your Government Services in One Place
    </h1>

    <p class="subtitle">
        A unified system that brings together all government agencies
        to facilitate transaction tracking and service delivery
        with speed and efficiency
    </p>
</section>

<section class="circles-container">
    <article class="circle-item">
        <div class="div-circle">1</div>
        <h3>Create Account</h3>
        <p>Sign up with simple and quick steps</p>
    </article>

    <article class="circle-item">
        <div class="div-circle">2</div>
        <h3>Choose Service</h3>
        <p>Browse available services and review required documents</p>
    </article>

    <article class="circle-item">
        <div class="div-circle">3</div>
        <h3>Track Transaction</h3>
        <p>Monitor your transaction progress and receive instant notifications</p>
    </article>
</section>

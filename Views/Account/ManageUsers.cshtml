@model List<Mamalti.Models.ApplicationUser>

@{
    ViewData["Title"] = "Manage Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 style="text-align:center; margin-top:20px; margin-bottom:30px;">
    Registered Users
</h1>

<form method="get" style="text-align:center; margin-bottom:20px;">
    <input type="text"
           name="search"
           value="@ViewBag.Search"
           placeholder="Search by name, email, phone"
           style="padding:10px; width:300px; border-radius:10px; border:1px solid #568259;" />

    <button type="submit"
            style="padding:10px 20px; border:none; background:#568259; color:white; border-radius:10px;">
        Search
    </button>
</form>


<table style="width: 90%; margin: 0 auto; border-collapse: collapse; font-size: 16px;">
    <thead>
        <tr style="background-color: #568259; color: white;">
            <th style="border: 1px solid #ccc; padding: 10px;">Id</th>
            <th style="border: 1px solid #ccc; padding: 10px;">Full Name</th>
            <th style="border: 1px solid #ccc; padding: 10px;">E-mail</th>
            <th style="border: 1px solid #ccc; padding: 10px;">Phone</th>
            <th style="border: 1px solid #ccc; padding: 10px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var user in Model)
            {
                <tr>
                    <td style="border: 1px solid #ccc; padding: 8px; text-align:center;">
                        @user.Id
                    </td>

                    <td style="border: 1px solid #ccc; padding: 8px;">
                        @user.FullName
                    </td>

                    <td style="border: 1px solid #ccc; padding: 8px;">
                        @user.Email
                    </td>

                    <td style="border: 1px solid #ccc; padding: 8px;">
                        @user.Phone
                    </td>

                    <td style="border: 1px solid #ccc; padding: 8px; text-align:center;">
                        <a asp-controller="Account" asp-action="EditUser" asp-route-id="@user.Id"
                           style="padding:6px 12px; background:#4b7c50; color:white; border-radius:8px; text-decoration:none;">
                            Edit
                        </a>

                        <a asp-controller="Account" asp-action="DeleteUser" asp-route-id="@user.Id"
                           onclick="return confirm('Are you sure you want to delete this user?');"
                           style="padding:6px 12px; background:#c0392b; color:white; border-radius:8px; text-decoration:none; margin-left:8px;">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" style="border: 1px solid #ccc; padding: 10px; text-align:center;">
                    No users found.
                </td>
            </tr>
        }
    </tbody>
</table>

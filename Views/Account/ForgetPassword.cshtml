@{
    ViewData["Title"] = "Forget Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="form-wrapper">
    <form onsubmit="return false;">
        <fieldset class="fieldset-ForgetPassword">

            <h1 style="text-align: center;margin-bottom: 80px;">Forget Password?</h1>

            <div id="fp-step1">
                <p><b style="font-size: 25px;">E-mail address:</b></p>
                <input id="fp-email" type="email"
                       placeholder="your-email@example.com"
                       style="border: 1px solid #568259; padding:10px 200px ; border-radius: 15px; font-size: large; text-align: left;" />

                <br /><br />

                <input type="button" value="Send Code" class="login-button"
                       style="margin-left: 19px; padding:10px 300px"
                       onclick="return sendCode();" />
            </div>

            <div id="fp-step2" style="display:none; margin-top:40px;">
                <p><b style="font-size: 20px;">New Password:</b></p>
                <input id="fp-newpass" type="password"
                       style="border: 1px solid #568259; padding:10px 200px ; border-radius: 15px; font-size: large; text-align: left;" />

                <p style="margin-top:25px;"><b style="font-size: 20px;">Confirm Password:</b></p>
                <input id="fp-confirmpass" type="password"
                       style="border: 1px solid #568259; padding:10px 200px ; border-radius: 15px; font-size: large; text-align: left;" />

                <br /><br />

                <input type="button" value="Change Password" class="login-button"
                       style="margin-left: 19px; padding:10px 260px"
                       onclick="return changePassword();" />
            </div>

            <p style="text-align: left; margin-top: 30px;">
                <a asp-controller="Account" asp-action="Signup" style="color:#055c0b; text-decoration:none;">
                    Create an account
                </a>
                &nbsp;
                <a asp-controller="Home" asp-action="About" style="color:#054b09; text-decoration:none;">
                    about us
                </a>
            </p>

        </fieldset>
    </form>
</div>

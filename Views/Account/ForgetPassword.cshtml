@{
    ViewData["Title"] = "Forget Password";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool showStep2 = false;
    if (ViewBag.ShowStep2 != null)
    {
        bool.TryParse(ViewBag.ShowStep2.ToString(), out showStep2);
    }
}

<div class="form-wrapper">
    <form asp-controller="Account"
          asp-action="ForgetPassword"
          method="post"
          onsubmit="return validateResetPassword();">

        <fieldset class="forget-fieldset">

            <h1>Forget Password?</h1>

            @if (ViewBag.Message != null)
            {
                <p style="color:red; text-align:center;">@ViewBag.Message</p>
            }

            <div id="step1" style="@(showStep2 ? "display:none;" : "display:block;")">
                <p style="font-size: 22px; margin-bottom: 30px; text-align: left; font-weight:bold;">
                    E-mail address:
                </p>

                <p>
                    <input id="forget-email"
                           type="email"
                           placeholder="your-email@example.com"
                           class="input-field" />
                </p>

                <button type="button" class="login-button" onclick="showResetForm();">
                    Send Code
                </button>
            </div>

            <div id="step2" style="@(showStep2 ? "display:block;" : "display:none;") margin-top:30px;">

                <input type="hidden" id="reset-email" name="email" />

                <p style="font-size: 20px; margin-bottom: 10px; text-align: left; font-weight:bold;">
                    Verification code:
                </p>
                <p>
                    <input id="reset-code"
                           type="text"
                           placeholder="Enter the code you received"
                           class="input-field" />
                </p>

                <p style="font-size: 20px; margin-bottom: 10px; text-align: left; font-weight:bold;">
                    New password:
                </p>
                <p>
                    <input id="new-password"
                           name="password"
                           type="password"
                           placeholder="********"
                           class="input-field" />
                </p>

                <p style="font-size: 20px; margin-bottom: 10px; text-align: left; font-weight:bold;">
                    Confirm password:
                </p>
                <p>
                    <input id="confirm-password"
                           name="confirmPassword"
                           type="password"
                           placeholder="********"
                           class="input-field" />
                </p>

                <button type="submit" class="login-button">
                    Change Password
                </button>
            </div>

            <div class="signup-bottom-text">
                <a asp-controller="Account" asp-action="Signup">Create an account</a>
                <span class="link-separator">|</span>
                <a asp-controller="Home" asp-action="About">about us</a>
            </div>


        </fieldset>
    </form>
</div>

<script>
    function showResetForm() {
        var emailInput = document.getElementById("forget-email");
        var email = emailInput.value.trim();

        if (email === "") {
            alert("Please enter your e-mail address.");
            emailInput.focus();
            return;
        }

        document.getElementById("reset-email").value = email;
        document.getElementById("step1").style.display = "none";
        document.getElementById("step2").style.display = "block";
    }

    function validateResetPassword() {
        var pass = document.getElementById("new-password").value;
        var confirm = document.getElementById("confirm-password").value;

        if (pass.length < 8) {
            alert("Password must be at least 8 characters.");
            return false;
        }

        if (pass !== confirm) {
            alert("Passwords do not match.");
            return false;
        }

        var hiddenEmail = document.getElementById("reset-email").value;
        if (!hiddenEmail || hiddenEmail.trim() === "") {
            alert("Please enter your e-mail and click 'Send Code' first.");
            return false;
        }

        return true;
    }
</script>

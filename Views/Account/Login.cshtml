@{
    ViewData["Title"] = "Log in";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="form-wrapper">
    <form asp-controller="Account" asp-action="Login" method="post" onsubmit="return handleLogin();">
        <fieldset>

            <h1>Log in</h1>
            <h4>Welcome back</h4>

            @if (ViewBag.Message != null)
            {
                <p style="color:red; text-align:center;">@ViewBag.Message</p>
            }

            @if (ViewBag.InfoMessage != null)
            {
                <p style="color:green; text-align:center;">@ViewBag.InfoMessage</p>
            }

            <p style="color: grey; font-size: 20px; margin-bottom: 30px; text-align: center;">
                Sign in to continue and access services
            </p>

            <p>
                E-mail address <br />
                <input id="login-email"
                       name="email"
                       type="email"
                       placeholder="YourE-mail@example.com"
                       class="input-field"
                       required
                       autocomplete="email" />
            </p>

            <p style="margin-bottom: 50px;">
                Password <br />
                <input id="login-password"
                       name="password"
                       type="password"
                       placeholder="********"
                       class="input-field"
                       required
                       autocomplete="current-password" />
            </p>

            <div class="login-links">
                <a asp-controller="Account" asp-action="ForgetPassword" class="login-link">
                    Forget Password?
                </a>

                <a asp-controller="Account" asp-action="Signup" class="login-link">
                    Create an account
                </a>

                <a asp-controller="Home" asp-action="About" class="login-link">
                    About us
                </a>
            </div>

            <input type="submit" value="login" class="login-button" />

        </fieldset>
    </form>
</div>
